{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "stop": "node scripts/Stop.js",
    "background": "vite --mode production >> '/dev/null' 2>&1 &",
    "dev": "vite --mode development",
    "build": "vite build",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
