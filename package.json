{
  "name": "ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "vue-cli-service serve",
    "stop": "node scripts/Stop.js",
    "background": "vue-cli-service serve --mode production >> '/dev/null' 2>&1 &",
    "dev": "vue-cli-service serve --watch --mode development",
    "build": "vue-cli-service build",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .js,.ts,.vue src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fingerprint/vue": "^2.0.0",
    "@lucide/vue": "^1.23.0",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "@types/node": "^26.1.0",
    "@vueuse/core": "^14.3.0",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.2",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "any-uri-scheme-webpack-plugin": "^1.0.2",
    "assert": "^2.1.0",
    "axios": "^1.18.1",
    "buffer": "^6.0.3",
    "core-js": "^3.49.0",
    "fs": "^0.0.1-security",
    "googleapis": "^173.0.0",
    "http": "^0.0.1-security",
    "https": "^1.0.0",
    "https-browserify": "^1.0.0",
    "material-design-icons-iconfont": "^6.7.0",
    "mdi-vue": "^3.0.13",
    "moment-timezone": "^0.6.2",
    "net": "^1.0.2",
    "os": "^0.1.2",
    "os-browserify": "^0.3.0",
    "path": "^0.12.7",
    "pinia": "^3.0.4",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "three": "^0.185.1",
    "tls": "^0.0.1",
    "url": "^0.11.4",
    "vite-plugin": "^0.0.0",
    "vm-browserify": "^1.1.2",
    "vue": "^3.5.39",
    "vue-class-component": "^8.0.0-0",
    "vue-router": "^4.6.4",
    "vue-toastification": "^2.0.0-rc.5",
    "vuetify": "^4.1.2",
    "vuex": "^4.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-plugin-typescript": "~5.0.8",
    "@vue/cli-plugin-vuex": "~5.0.0",
    "@vue/cli-service": "^5.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "cypress": "^15.21.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "selenium-webdriver": "^4.45.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
